server:
  port: 2333
  address: 127.0.0.1

lavalink:
  server:
    password: "cambia_esta_contraseña"
    sources:
      youtube: false  # IMPORTANTE: Deshabilitar el source antiguo
      bandcamp: true
      soundcloud: true
      twitch: false
      vimeo: false
      http: true
      local: false
    bufferDurationMs: 400
    frameBufferDurationMs: 5000
    youtubePlaylistLoadLimit: 6
    playerUpdateInterval: 5
    youtubeSearchEnabled: true
    soundcloudSearchEnabled: true
    gc-warnings: true
  plugins:
    # Plugin oficial de YouTube (ACTUALIZADO)
    - dependency: "dev.lavalink.youtube:youtube-plugin:1.18.0"
      snapshot: false
    # Plugin para Spotify y otras fuentes
    - dependency: "com.github.topi314.lavasrc:lavasrc-plugin:4.8.1"
      repository: "https://maven.lavalink.dev/releases"

metrics:
  prometheus:
    enabled: false
    endpoint: /metrics

sentry:
  dsn: ""
  environment: ""

logging:
  file:
    max-history: 30
    max-size: 1GB
  path: ./logs/

  level:
    root: INFO
    lavalink: INFO

plugins:
  youtube:
    enabled: true
    allowSearch: true
    allowDirectVideoIds: true
    allowDirectPlaylistIds: true
    clients:
      - MUSIC
      - ANDROID_VR
      - MWEB
    # Servidor remoto de cifrado (soluciona "must find sig function")
    remoteCipher:
      url: "https://cipher.kikkia.dev/"
      userAgent: "MediteaDJ"

  lavasrc:
    providers:
      - "ytsearch:\"%ISRC%\""
      - "ytsearch:%QUERY%"
    sources:
      spotify: true
      applemusic: false
      deezer: false
      yandexmusic: false
    spotify:
      clientId: "tu_spotify_client_id"
      clientSecret: "tu_spotify_client_secret"
      spDc: "tu_cookie_sp_dc_de_open.spotify.com"
      countryCode: "ES"
